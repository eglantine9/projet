def grey_scale_img(img):
    temp_img = img.copy()
    temp_img = img[:,:,0]*0.2126+img[:,:,1]*0.7152+img[:,:,2]*0.0722
    temp_img = temp_img.astype(np.uint8)
    plt.imshow(temp_img,cmap='gray', vmin=0, vmax=255) ; 
    plt.show()
    if img.shape[:2] != (64,64):
        image_pillow = Image.fromarray(temp_img)
        nouvelle_taille = (64, 64) # 2. On définie la nouvelle taille
        # 3. Redimensionnement avec filtre de haute qualité Lanczos
        image_reduite = image_pillow.resize(nouvelle_taille, Image.Resampling.LANCZOS)
       
    else:
        print("l'image est a la bonne taille)")
        image_reduite=temp_img

    plt.imshow(image_reduite,cmap='gray', vmin=0, vmax=255)
    plt.show()
    # 4. Sauvegarder l'image
    #image_reduite.save("image_64x64.jpg", quality=95)
    return(image_reduite)



